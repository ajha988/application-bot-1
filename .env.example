API_TOKEN=local-demo-change-me
DATA_DIR=data
MASTER_PROFILE=sample-profile.json
# Real browser preparation is opt-in. Exact approved HTTPS hosts only.
BROWSER_ENABLED=false
ALLOWED_APPLICATION_HOSTS=boards.greenhouse.io,jobs.lever.co
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_GRAPH_VERSION=v25.0
# Set true only after configuring Meta credentials and recipient consent.
WHATSAPP_SEND_ENABLED=false
# OAuth placeholders; email events can be ingested through /api/email/events.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Hosted/VPS deployment only; use a real domain and unique API_TOKEN.
# BOT_DOMAIN=applications.your-domain.example
# APP_ENV=production
